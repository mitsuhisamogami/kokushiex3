<% _base_tag_class =
     [
       'inline-flex items-center gap-2 rounded-md border px-4 py-2',
       'text-center font-bold text-slate-800 shadow-sm transition',
       'hover:border-blue-200 hover:bg-blue-50'
     ].join(' ')
   _checkbox_class = 'rounded-sm text-blue-950 focus:ring-blue-950' %>

<div class='flex flex-wrap body-font px-4 py-6'>
  <div class='w-full max-w-4xl mx-auto'>
    <div data-controller="tab" class='mb-10'>
      <div class="flex">
        <button data-tab-target="yearButton"
                data-action="tab#showYearTypes"
                class='border border-blue-950 bg-blue-950 text-white font-bold py-2 px-5 rounded-t-md transition'>
          模試形式
        </button>
        <button data-tab-target="tagButton"
                data-action="tab#showTagTypes"
                class='border border-slate-200 bg-slate-100 text-slate-700 font-bold py-2 px-5 rounded-t-md transition hover:bg-slate-200'>
          小テスト形式
        </button>
      </div>

      <!-- 年度選択 -->
      <div data-tab-target="year" class='w-full h-full rounded-lg rounded-tl-none border border-slate-200 bg-white overflow-hidden shadow-lg shadow-slate-200/60'>
        <div class='p-6'>
          <div class='flex items-center gap-4'>
            <div class='grid h-12 w-12 place-items-center rounded-lg bg-blue-50'>
              <%= image_tag 'calendar.png', class: 'h-10 w-10' %>
            </div>
            <h2 class='font-bold text-xl text-slate-950'>年度から選択</h2>
          </div>

          <div class='mt-6 grid grid-cols-1 gap-3 sm:grid-cols-2 lg:grid-cols-4'>
            <% @tests.each do |test| %>
              <%= button_to "第#{test.turn}回（#{test.year}年度）", test_path(test.id),
                            class: 'w-full rounded-md border border-slate-200 bg-slate-50 px-4 py-2 text-center
                            font-bold text-slate-800 shadow-sm transition hover:border-blue-200 hover:bg-blue-50
                            hover:text-blue-950', method: :get %>
            <% end %>
          </div>
        </div>
      </div>
      <!-- タグ選択 -->
      <div data-tab-target="tag" class='hidden w-full h-full rounded-lg rounded-tl-none border border-slate-200 bg-white overflow-hidden shadow-lg shadow-slate-200/60'>
        <div class='p-6'>
          <div class='flex items-center gap-4'>
            <div class='grid h-12 w-12 place-items-center rounded-lg bg-blue-50'>
              <%= image_tag 'tag.png', class: 'h-10 w-10' %>
            </div>
            <h2 class='font-bold text-xl text-slate-950'>タグから選択</h2>
          </div>
          <div class='mt-6'>
            <%= form_with url: mini_tests_path, method: :get do |f| %>
              <div class='border-b border-slate-100 pb-4'>
                <h3 class='font-bold text-slate-900'>問題数を選択</h3>
                <div class='mt-2 flex flex-wrap justify-start gap-5'>
                  <div class='inline-flex items-center gap-2 text-sm font-semibold text-slate-700'>
                    <%= radio_button_tag 'search[question_count]',
                                         10,
                                         true,
                                         id: 'question_count_10',
                                         class: 'text-blue-950 focus:ring-blue-950' %>
                    <%= label_tag 'question_count_10', '10問' %>
                  </div>
                  <div class='inline-flex items-center gap-2 text-sm font-semibold text-slate-700'>
                    <%= radio_button_tag 'search[question_count]',
                                         20,
                                         false,
                                         id: 'question_count_20',
                                         class: 'text-blue-950 focus:ring-blue-950' %>
                    <%= label_tag 'question_count_20', '20問' %>
                  </div>
                  <div class='inline-flex items-center gap-2 text-sm font-semibold text-slate-700'>
                    <%= radio_button_tag 'search[question_count]',
                                         30,
                                         false,
                                         id: 'question_count_30',
                                         class: 'text-blue-950 focus:ring-blue-950' %>
                    <%= label_tag 'question_count_30', '30問' %>
                  </div>
                </div>
              </div>

              <div class='border-b border-slate-100 py-4'>
                <h3 class='font-bold text-slate-900'>大分類から選択</h3>
                <div class='mt-3 flex flex-wrap justify-start gap-3'>
                  <% @major_categories.each do |tag| %>
                    <div class='<%= "#{_base_tag_class} border-slate-200 bg-slate-50" %>'>
                      <%= check_box_tag 'search[tag_ids][]',
                                        tag.id,
                                        false,
                                        id: "tag_#{tag.id}",
                                        class: _checkbox_class %>
                      <%= label_tag "tag_#{tag.id}", tag.name %>
                    </div>
                  <% end %>
                </div>
              </div>

              <div class='border-b border-slate-100 py-4'>
                <h3 class='font-bold text-slate-900'>共通問題から選択</h3>
                <div class='mt-3 flex flex-wrap justify-start gap-3'>
                  <% @common_tags.each do |tag| %>
                    <div class='<%= "#{_base_tag_class} border-blue-100 bg-blue-50/40" %>'>
                      <%= check_box_tag 'search[tag_ids][]',
                                        tag.id,
                                        false,
                                        id: "tag_#{tag.id}",
                                        class: _checkbox_class %>
                      <%= label_tag "tag_#{tag.id}", tag.name %>
                    </div>
                  <% end %>
                </div>
              </div>

              <div class='py-4'>
                <h3 class='font-bold text-slate-900'>専門問題から選択</h3>
                <div class='mt-3 flex flex-wrap justify-start gap-3'>
                  <% @special_tags.each do |tag| %>
                    <div class='<%= "#{_base_tag_class} border-slate-200 bg-slate-50" %>'>
                      <%= check_box_tag 'search[tag_ids][]',
                                        tag.id,
                                        false,
                                        id: "tag_#{tag.id}",
                                        class: _checkbox_class %>
                      <%= label_tag "tag_#{tag.id}", tag.name %>
                    </div>
                  <% end %>
                </div>
              </div>
              <div class='mt-2 flex justify-center gap-3'>
                <%= f.submit '小テストを始める', class: 'rounded-md bg-blue-950 px-5 py-2 font-bold text-white
                                                      shadow-sm shadow-blue-800/20 transition hover:bg-blue-900' %>
                <%= link_to '条件をクリア', tests_select_path, class: 'rounded-md border border-slate-200 bg-slate-100
                                                      px-5 py-2 font-bold text-slate-700 transition hover:bg-slate-200
                                                      hover:text-slate-950' %>
              </div>
            <% end %>
          </div>
        </div>
      </div>
    </div>
  </div>
</div>
